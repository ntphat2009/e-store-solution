@{
    ViewData["Title"] = "Thêm ngành hàng";
    Layout = "~/Areas/Admin/Views/Shared/_EmtyLayout.cshtml";
}

@if (ViewBag.CategoryInfo != null)
{
    <div class="single-product-tab-area mg-b-30" style="margin-left:20px">
        <div class="single-pro-review-area">
            <form action="/quan-li-nganh-hang/cap-nhat-nganh-hang" method="post" id="">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="review-tab-pro-inner">
                                <div style="float:right">
                                    <button type="submit" onclick="checkValidate(event)" data-toggle="tooltip" data-placement="left" title="Lưu" class="btn btn-action"><i class="fa-regular fa-floppy-disk" style="color:#1b2a47;"></i></button>
                                </div>
                                <ul id="myTab3" class="tab-review-design">
                                    <li class="active"><a href="#description"><i class="fa-regular fa-pen-to-square"></i> Cập nhật ngành hàng</a></li>
                                </ul>

                                <div id="myTabContent" class="tab-content custom-product-edit">
                                    <div class="product-tab-list tab-pane fade active in" id="description">
                                        <div class="row">
                                            <div class="col-lg-3">
                                                <div id="dropzone">
                                                    <div class="input-group">
                                                        <div class="input-group-append">
                                                            <img id="imgPreview_0" src="@Url.Content("~/uploads/images/"+@ViewBag.CategoryInfo.ImageURL)" alt="Preview Image" style="width:100%; height:auto; display:none;" />
                                                            <input name="Id" type="hidden" value="@ViewBag.CategoryInfo.Id" />
                                                            <input id="image-url" name="ImageURL" type="hidden" value="@ViewBag.CategoryInfo.ImageURL" />
                                                            <input style="color:white" name="formFile" type="file" lass="text-light" value="@ViewBag.CategoryInfo.ImageURL" id="insertImage_0" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-lg-9 col-md-9 col-sm-9 col-xs-12">
                                                <div class="review-content-section">
                                                    <div class="input-group mg-b-pro-edt">
                                                        <span class="input-group-addon">Tên ngành hàng</span>
                                                        <input id="name" type="text" name="Name" value="@ViewBag.CategoryInfo.Name" class="form-control" placeholder="Nhập tên ngành hàng...">
                                                    </div>
                                                    <div class="input-group mg-b-pro-edt">
                                                        <span class="input-group-addon"> Mô tả ngành hàng</span>
                                                        <input type="text" name="Description" value="@ViewBag.CategoryInfo.Description" class="form-control" id="description" placeholder="Mô tả ngành hàng">

                                                    </div>
                                                </div>

                                                <div class="review-content-section">
                                                    <div class="input-group mg-b-pro-edt">
                                                        <span class="input-group-addon">Vị trí hiển thị</span>
                                                        <input id="position" type="text" name="Position" value="@ViewBag.CategoryInfo.Position" class="form-control" placeholder="Vị trí hiển thị...">
                                                    </div>
                                                    <div class="input-group mg-b-pro-edt">
                                                        <span class="input-group-addon">Được cập nhật bởi</span>
                                                        <input id="updated-by" type="text" name="UpdatedBy" value="@ViewBag.CategoryInfo.UpdatedBy" class="form-control" placeholder="Được cập nhật bởi">
                                                        <input type="hidden" name="CreatedBy" value="@ViewBag.CategoryInfo.CreatedBy" class="form-control" placeholder="Được cập nhật bởi">
                                                        <input type="hidden" name="UpdatedDate" value="@DateTime.Now" class="form-control" placeholder="Được cập nhật bởi">
                                                    </div>
                                                    <div class="input-group mg-b-pro-edt">
                                                        <span class="input-group-addon">Trạng thái</span>
                                                        <select id="is-active" name="IsActive" class="form-control pro-edt-select form-control-primary">
                                                            <option value="true" @(ViewBag.CategoryInfo.IsActive == true ? "selected" : "")>Hoạt động</option>
                                                            <option value="false" @(ViewBag.CategoryInfo.IsActive == false ? "selected" : "")>Tạm dừng</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

}

<script src="~/js/admin/js/category.js"></script>
