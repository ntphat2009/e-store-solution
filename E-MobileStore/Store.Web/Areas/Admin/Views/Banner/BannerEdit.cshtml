@{
	ViewData["Title"] = "Thêm banner";
	Layout = "~/Areas/Admin/Views/Shared/_EmtyLayout.cshtml";

}
@if (ViewBag.BannerInfo != null)
{
	<div class="single-product-tab-area mg-b-30" style="margin-left:20px">
		<div class="single-pro-review-area">
			<form action="/quan-li-banner/cap-nhat-banner" method="post" enctype="multipart/form-data" id="">
				<div class="container-fluid">
					<div class="row">
						<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
							<div class="review-tab-pro-inner">
								<div style="float:right">
									<button type="submit" data-toggle="tooltip" data-placement="left" title="Lưu" onclick="checkValidate(event)" class="btn btn-action"><i class="fa-regular fa-floppy-disk" style="color:#1b2a47;"></i></button>
								</div>
								<ul id="myTab3" class="tab-review-design">
									<li class="active"><a href="#description"><i class="fa-regular fa-pen-to-square"></i> Cập nhật banner</a></li>
								</ul>

								<div id="myTabContent" class="tab-content custom-product-edit">
									<div class="product-tab-list tab-pane fade active in" id="description">
										<div class="row">
											<div class="col-lg-3">
												<div id="dropzone">
													<div class="input-group">
														<div class="input-group-append">
															<img id="imgPreview_0" src="@Url.Content("~/uploads/images/"+ @ViewBag.BannerInfo.ImageURL)" alt="Preview Image" style="width:100%; height:auto; display:none;" />
															<input name="Id" type="hidden" value="@ViewBag.BannerInfo.Id" />
															<input id="image-url" name="ImageURL" type="hidden" value="@ViewBag.BannerInfo.ImageURL" />
															<input style="color:white" name="formFile" type="file" lass="text-light" id="insertImage_0" />
														</div>
													</div>
												</div>
											</div>
											<div class="col-lg-9 col-md-9 col-sm-9 col-xs-12">
												<div class="review-content-section">
													<div class="input-group mg-b-pro-edt">
														<span class="input-group-addon">Tên banner</span>
														<input id="banner-alt" type="text" name="BannerAlt" value="@ViewBag.BannerInfo.BannerAlt" class="form-control" placeholder="Nhập tên banner...">
													</div>
													<div class="input-group mg-b-pro-edt">
														<span class="input-group-addon">Ngành hàng</span>
														<select id="category-id" name="CategoryId" class="form-control pro-edt-select form-control-primary">
															@if (ViewBag.CategoryList != null)
															{
																foreach (var category in ViewBag.CategoryList)
																{
																	<option value="@category.Id" @(category.Id == ViewBag.BannerInfo.CategoryId ? "selected" : "")>@category.Name</option>
																}
															}
														</select>
													</div>
													<div class="input-group mg-b-pro-edt">
														<span class="input-group-addon">Vị trí sắp xếp</span>
														<select id="position" name="Position" class="form-control pro-edt-select form-control-primary">
																@for (int i=1;i<8;i++)
																{
																	<option value="@i" @(i.ToString() == ViewBag.BannerInfo.Position ? "selected" : "")>@i</option>
																}
														</select>
													</div>
												</div>

												<div class="review-content-section">

													<div class="input-group mg-b-pro-edt">
														<span class="input-group-addon">Được cập nhật bởi</span>
														<input id="created-by" type="text" name="UpdatedBy" value="@ViewBag.BannerInfo.CreatedBy" class="form-control" placeholder="Được cập nhật bởi">
														<input type="hidden" name="CreatedBy" value="@ViewBag.BannerInfo.CreatedBy">
														<input type="hidden" name="UpdatedDate" value="@DateTime.Now" class="form-control" placeholder="Được cập nhật bởi">
													</div>
													<div class="input-group mg-b-pro-edt">
														<span class="input-group-addon">Trạng thái</span>
														<select id="is-active" name="IsActive" class="form-control pro-edt-select form-control-primary">
															<option value="true" @(ViewBag.BannerInfo.IsActive == true ? "selected" : "")>Hoạt động</option>
															<option value="false" @(ViewBag.BannerInfo.IsActive == false ? "selected" : "")>Tạm dừng</option>
														</select>
													</div>
												</div>
											</div>
										</div>

									</div>
								</div>
							</div>
						</div>
					</div>

				</div>
			</form>
		</div>
	</div>

}
<script src="~/js/admin/js/banner.js"></script>

