<div class="single-product-tab-area mg-b-30">
    <div class="single-pro-review-area">
        <form action="/quan-li-nganh-hang/them-nganh-hang" method="post" enctype="multipart/form-data" id="">

            <div class="container-fluid">
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="review-tab-pro-inner">
                            <div style="float:right">
                                <button type="submit" onclick="checkValidate(event)" data-toggle="tooltip" data-placement="left" title="Lưu" class="btn btn-action"><i class="fa-regular fa-floppy-disk" style="color:#1b2a47;"></i></button>
                            </div>
                            <ul id="myTab3" class="tab-review-design">
                                <li class="active"><a href="#description"><i class="fa-regular fa-pen-to-square"></i> Thêm ngành hàng</a></li>
                            </ul>

                            <div id="myTabContent" class="tab-content custom-product-edit">
                                <div class="product-tab-list tab-pane fade active in" id="description">
                                    <div class="row">
                                        <div class="col-lg-3">
                                            <div id="dropzone">
                                                <div class="input-group">
                                                    <div class="input-group-append">
                                                        <img id="imgPreview_0" src="" alt="Preview Image" style="width:100%; height:auto; display:none;" />
                                                        <input style="color:white" name="formFile" type="file" class="text-light" value="tải ảnh" id="insertImage_0" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-9 col-md-9 col-sm-9 col-xs-12">
                                            <div class="review-content-section">
                                                <div class="input-group mg-b-pro-edt">
                                                    <span class="input-group-addon">Tên ngành hàng</span>
                                                    <input id="name" type="text" name="Name" class="form-control" placeholder="Nhập tên ngành hàng...">
                                                </div>
                                                <div class="input-group mg-b-pro-edt">
                                                    <span class="input-group-addon"> Mô tả ngành hàng</span>
                                                    <input type="text" name="Description" class="form-control" id="description" placeholder="Mô tả ngành hàng...">
                                                </div>
                                            </div>
                                            <div class="review-content-section">
                                                <div class="input-group mg-b-pro-edt">
                                                    <span class="input-group-addon">Được thêm bởi</span>
                                                    <select id="position" name="Position" class="form-control pro-edt-select form-control-primary">
                                                        <option value="home">Trang chủ</option>
                                                        <option value="oder">Các trang khác</option>
                                                    </select>
                                                </div>
                                                <div class="input-group mg-b-pro-edt">
                                                    <span class="input-group-addon">Được thêm bởi</span>
                                                    <input id="created-by" type="text" name="CreatedBy" class="form-control" placeholder="Được thêm bởi">
                                                    <input type="hidden" name="CreatedDate" value="@DateTime.Now" class="form-control" placeholder="Được thêm bởi">
                                                </div>
                                                <div class="input-group mg-b-pro-edt">
                                                    <span class="input-group-addon">Trạng thái</span>
                                                    <select id="is-active" name="IsActive" class="form-control pro-edt-select form-control-primary">
                                                        <option value="true">Hoạt động</option>
                                                        <option value="false">Tạm dừng</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
